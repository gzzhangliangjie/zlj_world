{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.goose.walk": {
   "initial_state": "walking",
   "states": {
    "walking": {
     "animations": [
      {
       "walk": "query.modified_move_speed"
      }
     ],
     "transitions": [
      {
       "swimming": "query.is_in_water"
      }
     ]
    },
    "swimming": {
     "animations": [
      {
       "swim": "query.modified_move_speed"
      }
     ],
     "transitions": [
      {
       "walking": "!query.is_in_water"
      }
     ]
    }
   }
  }
 }
}